# Names only. Create Secret `live-secrets` out-of-band in namespace `gpt-live`.
# deploy-k8s.sh checks these exact keys without reading or printing their values.
DATABASE_URL=<secret-manager-reference>
S2S_API_KEY=<secret-manager-reference>
DEEPSEEK_API_KEY=<secret-manager-reference>
LIVE_STATIC_BEARER_TOKEN=<local-only-secret-manager-reference>
LIVE_ADMIN_BEARER_TOKEN=<secret-manager-reference>
LIVE_PRIVACY_HMAC_KEY=<base64-secret-manager-reference>
LIVE_RETENTION_HMAC_KEY=<base64-secret-manager-reference>
LIVE_TOOL_ENCRYPTION_KEY=<base64-32-byte-secret-manager-reference>

# Production Ingress uses a separate externally provisioned TLS Secret whose
# name is LIVE_PRODUCTION_TLS_SECRET and whose required keys are tls.crt/tls.key.
