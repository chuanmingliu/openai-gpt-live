package {{.Name}}

import (
	"context"
	"encoding/json"
	"testing"

	"github.com/chuanmingliu/openai-gpt-live/internal/worker"
)

type fakeBackend func(context.Context, json.RawMessage) (json.RawMessage, error)
func (backend fakeBackend) Execute(ctx context.Context, input json.RawMessage) (json.RawMessage, error) { return backend(ctx, input) }

func TestAdapterClonesBoundedInputAndOutput(t *testing.T) {
	adapter, err := New(fakeBackend(func(_ context.Context, input json.RawMessage) (json.RawMessage, error) {
		input[0] = '['
		return json.RawMessage(`{"ok":true}`), nil
	}))
	if err != nil { t.Fatal(err) }
	arguments := json.RawMessage(`{"query":"test"}`)
	result, err := adapter.Execute(context.Background(), worker.ToolExecutionRequest{Arguments: arguments})
	if err != nil { t.Fatal(err) }
	if string(arguments) != `{"query":"test"}` || string(result) != `{"ok":true}` { t.Fatal("adapter did not preserve owned values") }
}

func TestAdapterHonorsCancellation(t *testing.T) {
	adapter, _ := New(fakeBackend(func(ctx context.Context, _ json.RawMessage) (json.RawMessage, error) { return nil, ctx.Err() }))
	ctx, cancel := context.WithCancel(context.Background()); cancel()
	if _, err := adapter.Execute(ctx, worker.ToolExecutionRequest{Arguments: json.RawMessage(`{}`)}); err == nil { t.Fatal("expected cancellation") }
}
